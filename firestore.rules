rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Each user can read their own profile. Only the account itself may
    // create it (the manager sets these up once per person, see README).
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Reports: any signed-in head can create a report, and read the
    // recent list (since one shared account is used by all heads).
    // The manager can read everything.
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.headUid == request.auth.uid;
      allow read: if isSignedIn();
      allow update, delete: if isSignedIn() && myRole() == "manager";
    }
  }
}
